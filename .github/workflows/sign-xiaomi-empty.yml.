name: Sign Xiaomi empty APK
on:
  workflow_dispatch:
jobs:
  sign:
    runs-on: ubuntu-latest
    steps:
      - name: Prepare tools
        run: |
          yes | "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true
          "$ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager" "build-tools;35.0.0" || true
      - name: Sign the empty APK
        env:
          KEYSTORE_B64: ${{ secrets.KEYSTORE_B64 }}
          KS_PASS: ${{ secrets.KEY_PASSWORD }}
        run: |
          mkdir out
          echo "$KEYSTORE_B64" | base64 -d > "$RUNNER_TEMP/k.keystore"
          echo "" | base64 -d > out/in.apk
          AS
